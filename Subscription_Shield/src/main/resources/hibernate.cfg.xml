<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- JDBC Database Connection Settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/subscription_db</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">hem@l123</property>

        <!-- Hibernate SQL Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Echo all executed SQL to stdout (for debugging/demo) -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Schema validation ONLY - Hibernate will NEVER drop, alter, or recreate existing database tables -->
        <property name="hibernate.hbm2ddl.auto">update</property>

        <!-- Registered Entity Classes -->
        <mapping class="com.entity.User"/>
        <mapping class="com.entity.Category"/>
        <mapping class="com.entity.Subscription"/>
        <mapping class="com.entity.Payment"/>
        <mapping class="com.entity.Reminder"/>
    </session-factory>
</hibernate-configuration>
